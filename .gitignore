# Run artifacts are reviewed before any explicit Git inclusion.
experiments/*/*/
# Analysis outputs: the copied prior analysis is reference only (its own README says keep it out
# of Git; it holds prompt excerpts and a competing script). Per-item tables carry rationales
# and, with --include-prompts, licensed prompt text.
outputs/annotation_agreement_pilot/prior_analysis/
outputs/annotation_agreement_pilot/recomputed/disagreement_table.csv
outputs/annotation_agreement_pilot/source_crosstab/disagreement_table.csv
# Prediction dumps carry gold labels; keep them out of Git unless explicitly approved.
results/task_a_binary_*/predictions.csv
results/task_a_binary_*/**/predictions.csv
# Serialized models are large, regenerable artifacts.
results/task_a_binary_*/**/model.joblib
results/task_a_binary_*/**/model/
.ipynb_checkpoints/
results/task_a_smoke_baseline/predictions.csv
# Error-analysis tables carry gold labels; review-candidate CSVs also carry prompt text.
results/error_analysis/task_a_v2_*/
# Proposed label-review tables carry gold labels and model scores per example.
results/label_review/*/proposed_review.csv
results/task_b_*/**/predictions.csv
# RQ2 hard-negative predictions carry labels and per-example scores.
results/task_a_rq2_hard_negatives/**/predictions.csv
# RQ3 held-out runs: predictions carry labels and scores; models are large and regenerable.
results/task_a_rq3_*/**/predictions.csv
results/task_a_rq3_*/**/model.joblib
results/task_a_rq3_*/**/model/
