.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.DS_Store
.env
.env.*
!.env.example
*.pem
*.key
.pytest_cache/
.coverage
data/raw/*
data/*.parquet
data/interim/*
